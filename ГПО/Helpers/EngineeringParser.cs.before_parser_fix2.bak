using System;
using System.Collections.Generic;
using System.Globalization;

namespace MathApp.Helpers
{
    public static class EngineeringParser
    {
        /// <summary>
        /// Поддерживаемые форматы:
        /// 5e-14
        /// 0.05n
        /// 100u
        /// 1.2m
        /// 500 ms
        /// 500ms
        /// 0.5 s
        /// 100 us
        /// 100 µs
        /// 20 ns
        /// 2 ps
        ///
        /// Внутри все временные значения возвращаются в секундах.
        /// </summary>
        public static bool TryParse(string input, out double value)
        {
            value = 0;

            if (string.IsNullOrWhiteSpace(input))
                return false;

            string normalized = input
                .Trim()
                .Replace(',', '.')
                .Replace("μ", "u")
                .Replace("µ", "u");

            // Убираем пробелы между числом и единицей:
            // "500 ms" -> "500ms"
            normalized = normalized.Replace(" ", "");

            // Сначала проверяем составные единицы времени.
            // ВАЖНО: проверяем "ms" раньше, чем одиночную "m".
            var timeUnits = new Dictionary<string, double>(StringComparer.OrdinalIgnoreCase)
            {
                { "s",  1.0 },
                { "ms", 1e-3 },
                { "us", 1e-6 },
                { "ns", 1e-9 },
                { "ps", 1e-12 },
                { "fs", 1e-15 },
                { "as", 1e-18 }
            };

            foreach (var unit in timeUnits)
            {
                if (normalized.EndsWith(unit.Key, StringComparison.OrdinalIgnoreCase))
                {
                    string numberPart =
                        normalized.Substring(
                            0,
                            normalized.Length - unit.Key.Length);

                    if (double.TryParse(
                        numberPart,
                        NumberStyles.Any,
                        CultureInfo.InvariantCulture,
                        out double timeValue))
                    {
                        value = timeValue * unit.Value;
                        return true;
                    }
                }
            }

            // Старые инженерные суффиксы сохраняем.
            var suffixes = new Dictionary<char, double>
            {
                { 'p', 1e-12 },
                { 'n', 1e-9 },
                { 'u', 1e-6 },
                { 'm', 1e-3 },
                { 'k', 1e3 },
                { 'M', 1e6 },
                { 'G', 1e9 }
            };

            if (normalized.Length > 1)
            {
                char lastChar =
                    normalized[normalized.Length - 1];

                if (suffixes.ContainsKey(lastChar))
                {
                    string numberPart =
                        normalized.Substring(
                            0,
                            normalized.Length - 1);

                    if (double.TryParse(
                        numberPart,
                        NumberStyles.Any,
                        CultureInfo.InvariantCulture,
                        out double engineeringValue))
                    {
                        value =
                            engineeringValue *
                            suffixes[lastChar];

                        return true;
                    }
                }
            }

            // Обычное число без суффикса.
            if (double.TryParse(
                normalized,
                NumberStyles.Any,
                CultureInfo.InvariantCulture,
                out double plainValue))
            {
                value = plainValue;
                return true;
            }

            return false;
        }

        /// <summary>
        /// Преобразует число в читаемый инженерный формат.
        /// Для времени unit = "s":
        /// 0.5 -> 500 ms
        /// 0.0001 -> 100 us
        /// </summary>
        public static string ToEngineeringString(
            double value,
            string unit = "")
        {
            if (value == 0)
                return unit == "s"
                    ? "0 s"
                    : $"0{unit}";

            double abs = Math.Abs(value);

            // Для времени выводим привычные единицы.
            if (string.Equals(
                unit,
                "s",
                StringComparison.OrdinalIgnoreCase))
            {
                if (abs >= 1.0)
                    return $"{value:F6} s";

                if (abs >= 1e-3)
                    return $"{value * 1e3:F3} ms";

                if (abs >= 1e-6)
                    return $"{value * 1e6:F3} us";

                if (abs >= 1e-9)
                    return $"{value * 1e9:F3} ns";

                if (abs >= 1e-12)
                    return $"{value * 1e12:F3} ps";

                if (abs >= 1e-15)
                    return $"{value * 1e15:F3} fs";

                return $"{value * 1e18:F3} as";
            }

            // Общий инженерный вывод для остальных величин.
            if (abs >= 1e9)
                return $"{value / 1e9:F3} G{unit}";

            if (abs >= 1e6)
                return $"{value / 1e6:F3} M{unit}";

            if (abs >= 1e3)
                return $"{value / 1e3:F3} k{unit}";

            if (abs >= 1)
                return $"{value:F6} {unit}".Trim();

            if (abs >= 1e-3)
                return $"{value * 1e3:F3} m{unit}";

            if (abs >= 1e-6)
                return $"{value * 1e6:F3} u{unit}";

            if (abs >= 1e-9)
                return $"{value * 1e9:F3} n{unit}";

            if (abs >= 1e-12)
                return $"{value * 1e12:F3} p{unit}";

            return
                value.ToString(
                    "E3",
                    CultureInfo.InvariantCulture) +
                unit;
        }
    }
}
